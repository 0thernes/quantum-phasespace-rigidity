;;
;; Forward-Mode Dual-Number Automatic Differentiation Module:
;; Solves KKT optimality for the 2-qubit and 1-qutrit ASTAB circumradii
;; and verifies exact zero-residual match against Lean 4 closed forms:
;;   - 2-qubit R^2(ASTAB_0) = 3*(13 + 4*sqrt(3)) / 484
;;   - 1-qutrit R^2(ASTAB_0) = (7 - 3*sqrt(5)) / 6

(define (dual val der) (cons val der))
(define (dual-val z) (car z))
(define (dual-der z) (cdr z))

(define (d+ a b)
  (dual (+ (dual-val a) (dual-val b))
        (+ (dual-der a) (dual-der b))))

(define (d- a b)
  (dual (- (dual-val a) (dual-val b))
        (- (dual-der a) (dual-der b))))

(define (d* a b)
  (dual (* (dual-val a) (dual-val b))
        (+ (* (dual-der a) (dual-val b))
           (* (dual-val a) (dual-der b)))))

(define (d-sq a) (d* a a))

;; 2-qubit ASTAB upper-envelope Hilbert-Schmidt radius squared along Facet 1:
;;   l4 = (2 - sqrt(3)) * l1,  l2 = l3 = l4  (on [1/4, (7 + 3*sqrt(3))/22])
;;   f2q(l1) = l1^2 + 3 * ((1 - l1) / 3)^2 - 1/4 = (4/3)*l1^2 - (2/3)*l1 + 1/12
;; Derivative f2q'(l1) = (8/3)*l1 - 2/3 > 0 on (1/4, l1_max], proving boundary maximum!
(define (r2-astab-2q l1-dual)
  (let ((c43 (dual (/ 4.0 3.0) 0.0))
        (c23 (dual (/ 2.0 3.0) 0.0))
        (c112 (dual (/ 1.0 12.0) 0.0)))
    (d+ (d- (d* c43 (d-sq l1-dual)) (d* c23 l1-dual)) c112)))

;; 1-qutrit ASTAB upper-envelope along Facet 2: l3 = ((3 - sqrt(5))/2)*l1, l2 = 1 - l1 - l3
;;   f1qt(l1) = l1^2 + (1 - (1 + beta)*l1)^2 + (beta*l1)^2 - 1/3
(define (r2-astab-1qt l1-dual)
  (let ((beta (dual (* 0.5 (- 3.0 (sqrt 5.0))) 0.0))
        (one  (dual 1.0 0.0))
        (third (dual (/ 1.0 3.0) 0.0)))
    (let ((l3 (d* beta l1-dual))
          (l2 (d- (d- one l1-dual) (d* beta l1-dual))))
      (d- (d+ (d+ (d-sq l1-dual) (d-sq l2)) (d-sq l3)) third))))

;; Evaluate exact values and forward-mode AD gradients at the Lean-proved optimal vertices:
(define l1-opt-2q (/ (+ 7.0 (* 3.0 (sqrt 3.0))) 22.0))
(define res-2q (r2-astab-2q (dual l1-opt-2q 1.0)))

(define l1-opt-1qt 0.5)
(define res-1qt (r2-astab-1qt (dual l1-opt-1qt 1.0)))
